<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Printman.Desktop.Controls"
        x:Class="Printman.Desktop.Views.MainWindow"
        Title="Printman • Network Printer &amp; Web Server"
        Icon="avares://printman-desktop/Assets/app-icon.png"
        Width="920"
        Height="680"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" RowSpacing="14">

        <!-- Header Bar -->
        <Border Grid.Row="0"
                Padding="16"
                CornerRadius="10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Image Grid.Column="0"
                       Source="avares://printman-desktop/Assets/app-icon.png"
                       Width="40"
                       Height="40"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Printman Desktop"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <Border x:Name="StatusBadge"
                                CornerRadius="12"
                                Padding="10,3"
                                VerticalAlignment="Center"
                                Background="#64748B">
                            <TextBlock x:Name="StatusBadgeText"
                                       Text="Stopped"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText"
                               Text="Share any USB printer over AirPrint / Mopria and local Web UI."
                               FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="PrimaryActionButton"
                            Content="Start Sharing"
                            Classes="accent"
                            Padding="16,8"
                            FontWeight="SemiBold"
                            Click="OnPrimaryActionClick" />
                    <Button x:Name="OpenWebUiButton"
                            Content="Open Web UI"
                            Padding="12,8"
                            IsEnabled="False"
                            Click="OnOpenWebUiClick" />
                    <Button x:Name="OpenBrowserButton"
                            Content="Browser"
                            Padding="12,8"
                            IsEnabled="False"
                            Click="OnOpenBrowserClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Diagnostics / Notice Banner -->
        <Border x:Name="AlertBanner"
                Grid.Row="1"
                IsVisible="False"
                Padding="14,10"
                CornerRadius="8"
                BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="AlertTitleText"
                               FontWeight="SemiBold"
                               FontSize="13" />
                    <TextBlock x:Name="AlertBodyText"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="AlertCopyButton"
                            Content="Copy Fix"
                            IsVisible="False"
                            Click="OnAlertCopyClick" />
                    <Button x:Name="AlertRetryButton"
                            Content="Retry"
                            IsVisible="False"
                            Click="OnAlertRetryClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Two-Column Content -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16">

            <!-- Left Column: Setup & Printers -->
            <Border Grid.Column="0"
                    Padding="16"
                    CornerRadius="10"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0"
                                   Text="Printers &amp; Sharing Setup"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <CheckBox x:Name="ShareAllCheckBox"
                                  Grid.Column="1"
                                  Content="Share all"
                                  VerticalAlignment="Center"
                                  IsCheckedChanged="OnSettingChanged" />
                        <Button Grid.Column="2"
                                Content="Refresh"
                                Padding="10,4"
                                Click="OnRefreshPrintersClick" />
                    </Grid>

                    <!-- Printers Checklist -->
                    <Border Grid.Row="1"
                            Padding="10"
                            CornerRadius="8"
                            Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1">
                        <ScrollViewer>
                            <StackPanel x:Name="PrintersListPanel" Spacing="6" />
                        </ScrollViewer>
                    </Border>

                    <!-- Options Form -->
                    <StackPanel Grid.Row="2" Spacing="8">
                        <CheckBox x:Name="EnableSharingCheckBox"
                                  Content="Network Printer Sharing (AirPrint / Mopria / IPP)"
                                  IsCheckedChanged="OnSettingChanged" />

                        <Grid ColumnDefinitions="*,Auto,80" ColumnSpacing="8">
                            <CheckBox x:Name="EnableWebUiCheckBox"
                                      Grid.Column="0"
                                      Content="Enable Web UI Dashboard"
                                      VerticalAlignment="Center"
                                      IsCheckedChanged="OnSettingChanged" />
                            <TextBlock Grid.Column="1"
                                       Text="Port:"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBox x:Name="WebPortTextBox"
                                     Grid.Column="2"
                                     Text="5000"
                                     TextChanged="OnTextSettingChanged" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,120" ColumnSpacing="8">
                            <CheckBox x:Name="RequirePinCheckBox"
                                      Grid.Column="0"
                                      Content="Require PIN for Web UI"
                                      VerticalAlignment="Center"
                                      IsCheckedChanged="OnSettingChanged" />
                            <TextBlock Grid.Column="1"
                                       Text="PIN:"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <TextBox x:Name="CustomPinTextBox"
                                     Grid.Column="2"
                                     PlaceholderText="Auto 6-digit"
                                     MaxLength="8"
                                     TextChanged="OnTextSettingChanged" />
                        </Grid>

                        <CheckBox x:Name="PreferBuiltInWebViewCheckBox"
                                  Content="Open Web UI inside built-in App Window (WebView)"
                                  IsCheckedChanged="OnSettingChanged" />

                        <CheckBox x:Name="AutoStartCheckBox"
                                  Content="Start sharing automatically when Printman Desktop opens"
                                  IsCheckedChanged="OnSettingChanged" />

                        <Button x:Name="ApplyRestartButton"
                                Content="Apply Changes &amp; Restart Server"
                                IsVisible="False"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="10,7"
                                Click="OnApplyRestartClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Column: Phone Connection, QR Code & Activity -->
            <Border Grid.Column="1"
                    Padding="16"
                    CornerRadius="10"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <TextBlock Grid.Row="0"
                               Text="Connect Phones &amp; Devices"
                               FontSize="15"
                               FontWeight="SemiBold" />

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="12">
                            <!-- Idle State Instructions -->
                            <Border x:Name="IdleInfoPanel"
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Ready to Share"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="1. Tick the printers you want to share on the left."
                                               TextWrapping="Wrap"
                                               FontSize="12" />
                                    <TextBlock Text="2. Click Start Sharing to announce them over Wi-Fi (AirPrint / Mopria) and launch the mobile Web UI."
                                               TextWrapping="Wrap"
                                               FontSize="12" />
                                    <TextBlock Text="3. Closing this window keeps Printman running in the system tray / menu bar."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Running Web UI + QR Code Card -->
                            <Border x:Name="WebConnectionPanel"
                                    IsVisible="False"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Grid.Column="0"
                                            Padding="6"
                                            CornerRadius="6"
                                            Background="White"
                                            VerticalAlignment="Top">
                                        <controls:QrCodeControl x:Name="LanQrCode"
                                                                Width="132"
                                                                Height="132" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="Scan with your phone camera"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <ComboBox x:Name="LanUrlSelector"
                                                  HorizontalAlignment="Stretch"
                                                  SelectionChanged="OnLanUrlSelectionChanged" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Copy URL"
                                                    Padding="10,5"
                                                    Click="OnCopyLanUrlClick" />
                                            <Border x:Name="PinDisplayBadge"
                                                    Padding="8,4"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="PinDisplayText"
                                                           FontFamily="Consolas,Menlo,monospace"
                                                           FontWeight="Bold"
                                                           FontSize="13" />
                                            </Border>
                                            <Button x:Name="CopyPinButton"
                                                    Content="Copy PIN"
                                                    Padding="10,5"
                                                    Click="OnCopyPinClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Shared IPP Printers Card -->
                            <Border x:Name="SharedPrintersPanel"
                                    IsVisible="False"
                                    Padding="12"
                                    CornerRadius="8"
                                    Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="SharedPrintersHeaderText"
                                               Text="Network Printers (AirPrint / Mopria)"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <StackPanel x:Name="SharedPrintersLinksPanel" Spacing="6" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Live Activity Feed -->
                    <Border Grid.Row="2"
                            Padding="10"
                            CornerRadius="8"
                            Height="120"
                            Background="{DynamicResource SystemControlPageBackgroundChromeLowBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,*" RowSpacing="4">
                            <TextBlock Grid.Row="0"
                                       Text="Live Activity"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                            <ScrollViewer x:Name="ActivityScrollViewer" Grid.Row="1">
                                <StackPanel x:Name="ActivityLogPanel" Spacing="3" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Bar -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="Tip: Closing this window keeps Printman active in the system tray / menu bar."
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Button Grid.Column="1"
                    Content="Quit Printman"
                    Padding="12,5"
                    Click="OnQuitClick" />
        </Grid>

    </Grid>
</Window>
